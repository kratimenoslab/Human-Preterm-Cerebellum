    "import pandas as pd\n",
    "import numpy as np\n",
    "import seaborn as sns\n",
    "import matplotlib.pyplot as plt\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "coords = pd.read_csv('/mnt/morbo/Data/Users/kwoyshner/cerebellum/results/human_allGenes/coords_human.csv',index_col=0)\n",
    "meta = pd.read_csv('/mnt/morbo/Data/Users/kwoyshner/cerebellum/data/human_CB_meta.csv',index_col=0)\n",
    "meta['Patient_Replicate'] = meta.apply(lambda x: str(x['patient']) + '_' + x['replicate'], axis=1)\n",
    "\n",
    "clinical_meta = pd.read_excel('/mnt/morbo/Data/Users/kwoyshner/cerebellum/data/SpatialSeq subject Info(Updated)_subjectAdjusted.xlsx')\n",
    "clinical_meta_cell = meta.reset_index().merge(clinical_meta, left_on='patient', right_on='Subject', how='left').set_index('index')\n",
    "clinical_meta_cell['Patient_Replicate_PT'] = clinical_meta_cell.apply(lambda x: x['Patient_Replicate'] + '(' + x['GROUP'] + ')', axis=1)\n",
    "clinical_meta_cell_sub = clinical_meta_cell[clinical_meta_cell[patient'] != "outlier"]\n",
    "\n",
    "sorted_meta = clinical_meta_cell_sub.reset_index().groupby('Patient_Replicate').agg('first').sort_values(['GROUP','Patient_Replicate'])\n",
    "images = [x.split('_')[0] for x in sorted_meta.loc[:,'index']]\n",
    "hex_colors = pd.read_csv('/mnt/morbo/Data/Users/kwoyshner/cerebellum/projections/tricycle/theta_hex_colors.csv',index_col=0)\n",
    "hex_colors = hex_colors.set_index('angle')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Spatial data"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "metadata": {},
   "outputs": [],
   "source": [
